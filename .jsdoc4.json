{
  "tags": {
    "allowUnknownTags": false
  },
  "source": {
    "include": ["./prsm4/src", "./js/utils.js", "./js/samples.js"],
    "includePattern": ".js$"
  },
  "plugins": ["plugins/markdown", "./utils/jsdoc-prsm4.cjs"],
  "opts": {
    "template": "node_modules/docdash",
    "encoding": "utf8",
    "destination": "./doc/jsdoc4",
    "recurse": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  }
}
